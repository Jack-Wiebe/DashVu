# ------------------------------------------------------------------
# DashVu environment variables
# Copy this file to `.env` at the repository root and fill in values.
# `.env` is git-ignored and must never be committed.
# ------------------------------------------------------------------

# Base URL of the app. Use 127.0.0.1 (NOT localhost) for local dev:
# Spotify rejects `http://localhost` redirect URIs as "insecure" and only
# accepts HTTPS or loopback (127.0.0.1).
AUTH_URL=http://127.0.0.1:3000

# Random secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://127.0.0.1:3000/api/auth/callback/google
# Also: enable the "Google Calendar API" for the project and add the
# `.../auth/calendar.readonly` scope to the OAuth consent screen.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Spotify OAuth (https://developer.spotify.com/dashboard)
# Redirect URI: http://127.0.0.1:3000/api/auth/callback/spotify
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=

# Neon (serverless Postgres) connection string. Required at runtime for auth/DB;
# leave blank to run typecheck/build only.
# Get one from https://console.neon.tech or run a local Postgres.
DATABASE_URL=
